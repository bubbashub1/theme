{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1400px"
    },
    "color": {
      "palette": [
        {"slug":"ink","color":"#332044","name":"Bubba Purple"},
        {"slug":"ink-soft","color":"#655879","name":"Soft Purple"},
        {"slug":"paper","color":"#fcfaf7","name":"Warm White"},
        {"slug":"surface","color":"#ffffff","name":"White"},
        {"slug":"panel","color":"#e8f3f2","name":"Pastel Aqua"},
        {"slug":"teal","color":"#2ca6a5","name":"Bubba Teal"},
        {"slug":"teal-dark","color":"#217f82","name":"Deep Teal"},
        {"slug":"pink","color":"#f6a9d0","name":"Soft Pink"},
        {"slug":"peach","color":"#ffd4c5","name":"Peach"},
        {"slug":"coral","color":"#f36f72","name":"Coral"},
        {"slug":"yellow","color":"#f5c94b","name":"Sunny Yellow"},
        {"slug":"purple","color":"#4a285c","name":"Portal Purple"}
      ]
    },
    "typography": {
      "fontFamilies": [
        {"fontFamily":"Nunito, sans-serif","slug":"nunito","name":"Nunito"}
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|nunito",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|nunito",
          "lineHeight": "1.12"
        }
      }
    }
  }
}